#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Tokens sustituidos por meson al instalar. Desde el source tree quedan
# literales y se usa el directorio del script como fallback.
NB_INSTALLED_DATADIR='@NB_DATADIR@'
NB_INSTALLED_SYSCONFDIR='@NB_SYSCONFDIR@'
[[ "$NB_INSTALLED_DATADIR" == @*@ ]] && NB_INSTALLED_DATADIR="$SCRIPT_DIR/bootstrap"
[[ "$NB_INSTALLED_SYSCONFDIR" == @*@ ]] && NB_INSTALLED_SYSCONFDIR="$SCRIPT_DIR"

NB_VERSION="@NB_VERSION@"
[[ "$NB_VERSION" == @*@ ]] && NB_VERSION="v0.1"

DATA_DIR="${DATA_DIR:-$NB_INSTALLED_DATADIR/data}"
PACKS_DIR="${PACKS_DIR:-$NB_INSTALLED_DATADIR/packs}"

# Config: -c/--config > NB_CONFIG > sysconfdir instalado / raíz del repo.
# Pre-scan para que la CLI siempre gane al config (se sourcea antes del parseo).
NB_CONFIG="${NB_CONFIG:-$NB_INSTALLED_SYSCONFDIR/neonatox-bootstrap.conf}"
NB_CONFIG_CLI=""
_args=("$@")
for ((i = 0; i < ${#_args[@]}; i++)); do
    case "${_args[i]}" in
        -c|--config)
            if [[ -z "${_args[i+1]:-}" ]]; then
                echo "Error: ${_args[i]} requiere un archivo." >&2
                exit 1
            fi
            NB_CONFIG_CLI="${_args[i+1]}"
            NB_CONFIG="$NB_CONFIG_CLI"
            ;;
    esac
done
[[ -r "$NB_CONFIG" ]] && source "$NB_CONFIG"
# El config no puede reemplazar la ruta elegida por -c/--config.
[[ -n "$NB_CONFIG_CLI" ]] && NB_CONFIG="$NB_CONFIG_CLI"

LFS="${LFS:-/mnt}"
MODE=""

show_ver() {
	echo "${0} - ${NB_VERSION}"
	exit 0
}

show_help() {
    cat <<'EOF'
Uso: neonatox-bootstrap [opciones] <comando> [opciones-del-comando]

Comandos:
  core            Instalar sistema base (directorios, nhopkg, config, paquetes core)
  kde             Instalar escritorio KDE sobre core existente
  gnome           Instalar escritorio GNOME sobre core existente
  xfce            Instalar escritorio XFCE sobre core existente
  user            Crear usuario del sistema (user --help para opciones)
  grub            Instalar GRUB en dispositivo detectado (grub --help para opciones)
  chroot          Entrar en chroot interactivo en $LFS

Opciones globales:
  -L, --lfs <ruta>      Directorio raíz de destino (default: $LFS env o /mnt; NUNCA /)
  -c, --config <archivo> Archivo de configuración (default: neonatox-bootstrap.conf)
  --hostname <nombre>   Sobrescribir nombre de host autogenerado
  --device <disp>       Dispositivo para fstab (detección automática)
  --uuid <uuid>         UUID para fstab (detección automática)
  --fstype <tipo>       Tipo de sistema de archivos (detección automática)
  -z, --timezone <zona>     Zona horaria (default: detectada del host)
  -l, --locale <locale>     Locale (default: en_US.UTF-8)
  --libc {glibc|musl}       Perfil de libc del target (default: glibc, repo n27)
  --no-busybox              Construir nhopkg sin BusyBox estático (solo si se compila)
  --host-nhopkg             Usar el nhopkg del host como driver (no construye;
                            perfil por defecto del config de netinstall).
  --no-cleanup              Saltar limpieza post-instalación
  --skip-sentinel           No exigir el sentinel de core para chroot/user/grub
                            (para sistemas o instalaciones sin sentinel)
  --pack-dir <ruta>         Directorio de archivos de paquetes
  -h, --help                Mostrar esta ayuda
  -v, --version             Muestra la version

Variables de entorno:
  LFS                       Directorio raíz de destino (equivale a --lfs)
  NB_CONFIG                 Archivo de configuración (equivale a --config)
  NB_HOST_NHOPKG=1          Equivale a --host-nhopkg
  NB_SKIP_SENTINEL=1        Equivale a --skip-sentinel

Precedencia: CLI > archivo de configuración > entorno > defaults.
El config de ejemplo incluye el perfil NETINSTALL (nhopkg del host, sin
gettext, sin BusyBox; zstd y BusyBox los provee neonatox-live-boot).

Use 'neonatox-bootstrap user --help' o 'neonatox-bootstrap grub --help'
para opciones específicas de cada subcomando.
EOF
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -L|--lfs) LFS="$2"; shift 2 ;;
        -c|--config) shift 2 ;;   # ya se sourceó en el pre-scan
        --hostname) NHOSTNAME="$2"; shift 2 ;;
        --device) DEVICE_OVERRIDE="$2"; shift 2 ;;
        --uuid) UUID_OVERRIDE="$2"; shift 2 ;;
        --fstype) FSTYPE_OVERRIDE="$2"; shift 2 ;;
        -z|--timezone) TZONE="$2"; shift 2 ;;
        -l|--locale) LOCALE="$2"; shift 2 ;;
        --libc) LIBC="$2"; shift 2 ;;
        --no-busybox) BUSYBOX=0; shift ;;
        --host-nhopkg) HOST_NHOPKG=1; shift ;;
        --skip-sentinel) SKIP_SENTINEL=1; shift ;;
        --no-cleanup) SKIP_CLEANUP=1; shift ;;
        --pack-dir) PACKS_DIR="$2"; shift 2 ;;
        -h|--help) show_help ;;
        -v|--version) show_ver ;;
        core|kde|gnome|xfce|chroot|user|grub) MODE="$1"; shift; break ;;
        *) echo "Error: argumento desconocido: $1" >&2; show_help ;;
    esac
done

[[ -z "$MODE" ]] && MODE="core"

LIBC="${LIBC:-glibc}"
BUSYBOX="${BUSYBOX:-1}"
HOST_NHOPKG="${HOST_NHOPKG:-${NB_HOST_NHOPKG:-0}}"
SKIP_SENTINEL="${SKIP_SENTINEL:-${NB_SKIP_SENTINEL:-0}}"
[[ "$LIBC" == "glibc" || "$LIBC" == "musl" ]] || {
    echo "Error: --libc debe ser 'glibc' o 'musl' (recibido: $LIBC)." >&2
    exit 1
}

# Modo nhopkg del host: requiere un nhopkg operativo en el PATH del host.
if [[ "$HOST_NHOPKG" == "1" ]]; then
    command -v nhopkg >/dev/null 2>&1 || {
        echo "Error: --host-nhopkg/NB_HOST_NHOPKG pide usar el nhopkg del host," >&2
        echo "       pero 'nhopkg' no está en el PATH. Instálelo o quite la opción." >&2
        exit 1
    }
    [[ "$BUSYBOX" == "0" ]] && echo "  [aviso] --no-busybox no aplica con --host-nhopkg (receta del host)"
fi

# Verificar que LFS no sea la raíz del host
[[ "$LFS" != "/" ]] || {
    echo "Error: LFS apunta a la raíz del sistema host ($LFS). Abortando." >&2
    exit 1
}

# Verificar que LFS exista y sea un punto de montaje (solo en core)
if [[ "$MODE" == "core" ]]; then
    [[ -d "$LFS" ]] || {
        echo "Error: $LFS no existe. Créelo y monte el sistema de archivos destino." >&2
        exit 1
    }
    if command -v mountpoint >/dev/null 2>&1; then
        mountpoint -q "$LFS" || {
            echo "Error: $LFS no es un punto de montaje. Monte el sistema de archivos destino en $LFS." >&2
            exit 1
        }
    else
        awk -v d="$LFS" '$2==d{found=1} END{exit !found}' /proc/mounts || {
            echo "Error: $LFS no es un punto de montaje. Monte el sistema de archivos destino en $LFS." >&2
            exit 1
        }
    fi
fi

##################################################
#  nhopkg: build único en el target (driver del host + nhopkg final)
##################################################
# BusyBox estático va por defecto (--no-busybox lo desactiva): nhouser lo usa
# como backend de creación de usuarios/grupos cuando no hay shadow-utils, y
# el PATH privado cubre las tools que el host pueda no tener.
NHOPKG_NEEDED_TOOLS=(wget curl grep sed awk sort tar zstd sha256sum)

nhopkg_probe_recipe() {
    local recipe=()
    if [[ "$LIBC" == "musl" ]]; then
        recipe=(-D binlocate=plocate -D repo-version=n27 -D repo-arch=x86_64-musl -D libc=musl -D git-branch=musl)
    else
        recipe=(-D binlocate=plocate -D repo-version=n27 -D repo-arch=x86_64)
    fi

    local tool missing=0
    for tool in "${NHOPKG_NEEDED_TOOLS[@]}"; do
        command -v "$tool" >/dev/null 2>&1 || missing=1
    done
    [[ "$missing" == "1" ]] && echo "  [info] faltan tools en el host; el PATH privado de BusyBox las cubre"

    if [[ "$BUSYBOX" == "1" ]]; then
        recipe+=(-D use-busybox=yes -D static-busybox=auto -D static-zstd=auto)
    else
        echo "  [info] --no-busybox: nhopkg usará las tools del host/target"
        recipe+=(-D use-busybox=no -D static-busybox=no -D static-zstd=no)
    fi

    # Args extra del config: se agregan al final para que el último -D gane.
    if [[ -n "${NHOPKG_MESON_ARGS:-}" ]]; then
        local extra=()
        read -ra extra <<< "$NHOPKG_MESON_ARGS"
        recipe+=("${extra[@]}")
    fi

    NHOPKG_RECIPE=("${recipe[@]}")
}

nhopkg_require_build_tools() {
    local cmd
    for cmd in git meson ninja; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            echo "Error: falta $cmd en el host para construir nhopkg." >&2
            echo "       Instálelo (git, meson, ninja) o use un prebuilt (futuro)." >&2
            exit 1
        fi
    done
}

nhopkg_clone() {
    if [[ ! -d /tmp/nhopkg/.git ]]; then
        rm -rf /tmp/nhopkg
        git clone --depth 1 https://github.com/cargabsj175/neonatox-nhopkg.git /tmp/nhopkg
    fi
}

# nhopkg se construye desde fuente solo si HOST_NHOPKG=0: un único árbol con
# prefix estándar (/usr, /etc, /var) instalado en $LFS vía DESTDIR. Ese árbol
# es a la vez el nhopkg final del target y el driver del host (rutas por env).
# El marker depende del hash de la receta, así que cambios de libc, BusyBox,
# repo-version o NHOPKG_MESON_ARGS fuerzan un rebuild.
# Con --host-nhopkg no se construye nada: lo provee neonatox-live-boot.
nhopkg_recipe_marker() {
    local digest
    if command -v sha256sum >/dev/null 2>&1; then
        digest=$(printf '%s\n' "${NHOPKG_RECIPE[@]}" | sha256sum | cut -c1-12)
    else
        digest=$(printf '%s\n' "${NHOPKG_RECIPE[@]}" | cksum | cut -d' ' -f1)
    fi
    echo "$LFS/etc/nhopkg/.recipe-$digest"
}

# Aplica NHOPKG_CONF_OVERRIDES al final de la conf del target. Se reemplaza el
# bloque en cada run para que el config siga siendo mandatorio en re-runs.
nhopkg_apply_target_conf_overrides() {
    local conf="$LFS/etc/nhopkg/nhopkg.conf"
    [[ -f "$conf" ]] || return 0
    sed -i '/^# BEGIN neonatox-bootstrap overrides$/,/^# END neonatox-bootstrap overrides$/d' "$conf"
    [[ -z "${NHOPKG_CONF_OVERRIDES:-}" ]] && return 0
    {
        echo "# BEGIN neonatox-bootstrap overrides"
        printf '%s\n' "$NHOPKG_CONF_OVERRIDES"
        echo "# END neonatox-bootstrap overrides"
    } >> "$conf"
}

nhopkg_build() {
    [[ "$HOST_NHOPKG" == "1" ]] && return 0
    local bb="no"
    [[ "$BUSYBOX" == "1" ]] && bb="yes"
    nhopkg_probe_recipe
    local marker
    marker=$(nhopkg_recipe_marker)
    if [[ -x "$LFS/usr/bin/nhopkg" && -f "$marker" ]]; then
        nhopkg_apply_target_conf_overrides
        return 0
    fi
    nhopkg_require_build_tools
    nhopkg_clone
    rm -f "$LFS"/etc/nhopkg/.recipe-* "$LFS"/etc/nhopkg/.libc-* 2>/dev/null || true
    echo "=== [core] Construyendo e instalando nhopkg ($LIBC, busybox=$bb) en $LFS ==="
    pushd /tmp/nhopkg >/dev/null || exit 1
    rm -rf build
    meson setup build \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        "${NHOPKG_RECIPE[@]}"
    DESTDIR="$LFS" ninja -C build install
    popd >/dev/null || exit 1
    touch "$marker"
    nhopkg_apply_target_conf_overrides
}

# En netinstall el live provee nhopkg, zstd y BusyBox. Validar las tools que
# nhopkg invoca "desnudas" para fallar temprano con un mensaje claro.
nhopkg_preflight_host() {
    local tool missing=0
    for tool in nhopkg zstd tar sha256sum; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            echo "Error: falta '$tool' en el PATH para usar el nhopkg del host." >&2
            echo "       neonatox-live-boot debe proveerlo (zstd no es applet de BusyBox)." >&2
            missing=1
        fi
    done
    if ! command -v wget >/dev/null 2>&1 && ! command -v curl >/dev/null 2>&1; then
        echo "Error: falta wget o curl en el PATH para usar el nhopkg del host." >&2
        missing=1
    fi
    [[ "$missing" == "0" ]] || exit 1
}

# Config del host: NB_NHOPKG_CONF o NHOPKG_CONF del entorno/config. Si hay
# overrides, se copia a un temporal y se le agrega el bloque para no tocar
# la conf del live. Se limpia en cleanup_all().
nhopkg_host_conf_prepare() {
    # El nhopkg del live usa sus propias libs: no heredar rutas de un build
    # previo apuntando a otro $LFS.
    unset NHOPKG_LIB NHOPKG_UDEP_LIB NHOPKG_DOWNLOAD_LIB NHOPKG_CRYPTO_LIB
    local src="${NB_NHOPKG_CONF:-${NHOPKG_CONF:-}}"
    if [[ -z "$src" && -n "${NHOPKG_CONF_OVERRIDES:-}" ]]; then
        src="/etc/nhopkg/nhopkg.conf"
    fi
    if [[ -n "$src" ]]; then
        [[ -r "$src" ]] || {
            echo "Error: no se puede leer la conf de nhopkg: $src" >&2
            exit 1
        }
        if [[ -n "${NHOPKG_CONF_OVERRIDES:-}" ]]; then
            NHOPKG_HOST_TMP_CONF="${TMPDIR:-/tmp}/neonatox-bootstrap-nhopkg.conf.$$"
            cp "$src" "$NHOPKG_HOST_TMP_CONF"
            {
                echo "# BEGIN neonatox-bootstrap overrides"
                printf '%s\n' "$NHOPKG_CONF_OVERRIDES"
                echo "# END neonatox-bootstrap overrides"
            } >> "$NHOPKG_HOST_TMP_CONF"
            export NHOPKG_CONF="$NHOPKG_HOST_TMP_CONF"
        else
            export NHOPKG_CONF="$src"
        fi
    else
        unset NHOPKG_CONF
    fi

    if [[ "${NHOPKG_USE_BUSYBOX:-no}" == "yes" ]]; then
        [[ -n "${NB_NHOPKG_BB_DIR:-}" ]] && export NHOPKG_BB_DIR="$NB_NHOPKG_BB_DIR"
        [[ -n "${NB_NHOPKG_BB_SETUP:-}" ]] && export NHOPKG_BB_SETUP="$NB_NHOPKG_BB_SETUP"
    else
        unset NHOPKG_BB_DIR NHOPKG_BB_SETUP
    fi
}

# Prepara el entorno del host para usar el nhopkg del target como driver
# operando sobre --root $LFS (exporta conf y libs apuntando a $LFS).
# El driver se invoca por ruta absoluta: el bin del target NO se expone al PATH.
nhopkg_prepare() {
    # Configurable desde neonatox-bootstrap.conf; default no (sin gettext).
    export NHOPKG_GETTEXT="${NHOPKG_GETTEXT:-no}"

    if [[ "$HOST_NHOPKG" == "1" ]]; then
        nhopkg_preflight_host
        nhopkg_host_conf_prepare
        echo "  [ok] nhopkg del host ($(command -v nhopkg)) ($LIBC)"
        return 0
    fi
    nhopkg_build

    nhopkg() { "$LFS/usr/bin/nhopkg" "$@"; }

    export NHOPKG_CONF="$LFS/etc/nhopkg/nhopkg.conf"
    export NHOPKG_LIB="$LFS/usr/lib/nhopkg/libnhopkg"
    export NHOPKG_UDEP_LIB="$LFS/usr/lib/nhopkg/libnhopkg_udepsys"
    export NHOPKG_DOWNLOAD_LIB="$LFS/usr/lib/nhopkg/libnhopkg_download"
    export NHOPKG_CRYPTO_LIB="$LFS/usr/lib/nhopkg/libnhopkg_crypto"

    if [[ "$BUSYBOX" == "1" ]]; then
        # El PATH privado solo se inyecta dentro del chroot (hooks de paquete).
        # En el host los applets se invocan por ruta absoluta cuando faltan.
        if [[ -x "$LFS/usr/lib/nhopkg/bin/busybox" ]]; then
            NHOPKG_BB_DIR="$LFS/usr/lib/nhopkg/bin" \
                "$LFS/usr/lib/nhopkg/nhopkg-bb-setup" --regenerate >/dev/null 2>&1 || true
            export NHOPKG_BB_DIR="$LFS/usr/lib/nhopkg/bin"
            export NHOPKG_BB_SETUP="$LFS/usr/lib/nhopkg/nhopkg-bb-setup"
        else
            echo "  [aviso] BusyBox estático no disponible; nhopkg usará las tools del host/target"
        fi
    else
        unset NHOPKG_BB_DIR NHOPKG_BB_SETUP
    fi
    echo "  [ok] nhopkg Ready ($LIBC)"
}

# Variables globales para detección de disco y EFI
BASE_DISK=""
EFI_PART=""

# Marcadores de estado
CORE_SENTINEL="${LFS}/var/nhopkg/.core-installed"
DE_SENTINEL="${LFS}/var/nhopkg/.desktop-common-installed"

core_instalado() { [[ -f "$CORE_SENTINEL" ]]; }
de_common_instalado() { [[ -f "$DE_SENTINEL" ]]; }

# Gate de los comandos que exigen `core` (chroot/user/grub).
# --skip-sentinel (o NB_SKIP_SENTINEL=1) lo salta para sistemas o
# instalaciones sin sentinel; la idempotencia de `core` y los
# auto-triggers de los DEs no cambian.
requiere_core() {
    core_instalado && return 0
    if [[ "$SKIP_SENTINEL" == "1" ]]; then
        [[ -d "$LFS" ]] || {
            echo "Error: $LFS no existe (no hay sentinel ni target)." >&2
            exit 1
        }
        echo "  [aviso] sentinel ausente; forzado por --skip-sentinel" >&2
        return 0
    fi
    echo "Error: ejecute 'core' primero." >&2
    exit 1
}

# Limpieza al salir (error, Ctrl+C, fin normal)
cleanup_all() {
    chroot_cleanup
    rm -rf /tmp/nhopkg /tmp/nhopkg.zip 2>/dev/null || true
    rm -f "${NHOPKG_HOST_TMP_CONF:-}" 2>/dev/null || true
}
trap cleanup_all EXIT INT TERM

[[ "${EUID}" == "0" ]] || {
    echo "Error: este script debe ejecutarse como root." >&2
    exit 1
}

##################################################
#  Chroot helpers (mount/unmount VFS)
##################################################
chroot_prepare() {
    mount --bind /dev "${LFS}/dev" 2>/dev/null || true
    mount -t devpts devpts -o gid=5,mode=0620 "${LFS}/dev/pts" 2>/dev/null || true
    mount -t proc proc "${LFS}/proc" 2>/dev/null || true
    mount -t sysfs sysfs "${LFS}/sys" 2>/dev/null || true
    mount -t tmpfs tmpfs "${LFS}/run" 2>/dev/null || true
    if [ -h "${LFS}/dev/shm" ]; then
        install -d -m 1777 "${LFS}$(realpath /dev/shm)" 2>/dev/null || true
    else
        mount -t tmpfs -o nosuid,nodev tmpfs "${LFS}/dev/shm" 2>/dev/null || true
    fi
}

chroot_cleanup() {
    umount -l "${LFS}/dev/shm" 2>/dev/null || true
    umount -l "${LFS}/dev/pts" 2>/dev/null || true
    umount -l "${LFS}/run"     2>/dev/null || true
    umount -l "${LFS}/sys"     2>/dev/null || true
    umount -l "${LFS}/dev"     2>/dev/null || true
    umount -l "${LFS}/proc"    2>/dev/null || true
}

chroot_run() {
    chroot "$LFS" /bin/bash -c "$*"
}

##################################################
#  Detectar disco base desde el punto de montaje
##################################################
detect_base_disk() {
    local dev
    if command -v findmnt >/dev/null 2>&1; then
        dev=$(findmnt -no SOURCE --target "$LFS" 2>/dev/null | sed 's/\[.*\]//' | tr -d '[:space:]')
    fi
    if [[ -z "$dev" ]] || [[ ! -b "$dev" ]]; then
        dev=$(df -P "$LFS" | awk 'NR==2{print $1}' | sed 's/\[.*\]//')
    fi
    if [[ ! -b "$dev" ]]; then
        echo "Error: No se pudo detectar dispositivo desde $LFS" >&2
        return 1
    fi
    BASE_DISK=$(echo "$dev" | sed 's/[0-9]*$//; s/p$//')
    echo "Disco base detectado: $BASE_DISK (desde $dev)"
}

##################################################
#  Detectar partición EFI en el disco base
##################################################
detect_efi() {
    [[ -n "$BASE_DISK" && -b "$BASE_DISK" ]] || return 1
    command -v lsblk >/dev/null 2>&1 || return 1

    local part mpoint fstype
    while IFS= read -r line; do
        part=$(echo "$line" | awk '{print $1}')
        mpoint=$(echo "$line" | awk '{print $2}')
        fstype=$(echo "$line" | awk '{print $3}')
        [[ "$fstype" != "vfat" ]] && continue
        [[ "$mpoint" != "$LFS"* ]] && continue

        local rel="${mpoint#$LFS}"
        [[ -z "$rel" ]] && rel="/"
        echo "    [INFO] partición EFI detectada: /dev/$part montada en $mpoint"
        EFI=1
        EFI_DIR="$rel"
        EFI_PART="/dev/$part"
        return 0
    done < <(lsblk -ln -o NAME,MOUNTPOINT,FSTYPE "$BASE_DISK" 2>/dev/null | awk '$2!=""{print $0}')

    return 1
}

##################################################
#  Install base system —  01-base-neonatox.sh
##################################################
install_core() {
	section="Core"
    if core_instalado; then
        echo "core ya instalado en $LFS. Saltando." >&2
        return 0
    fi
    echo "=== [core] Creando jerarquía de directorios ==="
    
    mkdir -p ${LFS}/usr/{bin,lib}
    ln -sf usr/lib ${LFS}/lib64
    ln -sf lib ${LFS}/usr/lib64

    if [[ "$LIBC" == "glibc" ]]; then
        mkdir -p ${LFS}/usr/lib32
        ln -sf usr/lib32 ${LFS}/lib32
    fi

    # merged-usr
    ln -sf usr/bin   ${LFS}/bin
    ln -sf usr/bin   ${LFS}/sbin
    ln -sf usr/lib   ${LFS}/lib
    ln -sf bin       ${LFS}/usr/sbin

    mkdir -p ${LFS}/{dev,proc,sys,run}
    mkdir -p ${LFS}/{boot,home,mnt,opt,srv}
    mkdir -p ${LFS}/etc/{opt,sysconfig,skel,profile.d}
    mkdir -p ${LFS}/etc/{polkit-1,udev}/rules.d
    mkdir -p ${LFS}/lib/firmware
    mkdir -p ${LFS}/media/{floppy,cdrom}
    mkdir -p ${LFS}/usr/{,local/}{include,src}
    mkdir -p ${LFS}/usr/lib/locale
    mkdir -p ${LFS}/usr/local/{bin,lib,sbin}
    mkdir -p ${LFS}/usr/{,local/}share/{color,dict,doc,info,locale,man}
    mkdir -p ${LFS}/usr/{,local/}share/{misc,terminfo,zoneinfo}
    mkdir -p ${LFS}/usr/{,local/}share/man/man{1..8}
    mkdir -p ${LFS}/var/{cache,local,log,mail,opt,spool}
    mkdir -p ${LFS}/var/lib/{color,misc,locate}
    # evitar que enlacen al host con ..
    ln -sf ../run ${LFS}/var/run
    ln -sf ../run/lock ${LFS}/var/lock
    
    install -d -m 0750 ${LFS}/root
    install -d -m 1777 ${LFS}/tmp ${LFS}/var/tmp

    echo "=== [core] Copiando archivos de configuración estáticos ==="
    cp -a "$DATA_DIR/etc/." "$LFS/etc/"
    cp -a "$DATA_DIR/etc/skel/." "$LFS/root/"

    if [[ -n "${LOCALE:-}" ]]; then
        cat > "${LFS}/etc/locale.conf" <<EOF
# Generated by neonatox-bootstrap

export LANG=$LOCALE

EOF
    fi

    echo "=== [core] Enlaces simbólicos del sistema ==="
    ln -sf /proc/self/mounts "${LFS}/etc/mtab"

    echo "=== [core] Creando directorios para metadata de nhopkg ==="
    mkdir -p ${LFS}/var/nhopkg/{cache,files,logs,packages,repo}

    echo "=== [core] Generando archivos dinámicos ==="

    # fstab — detecta dispositivo/UUID/FSTYPE
    DEV=""
    if command -v findmnt >/dev/null 2>&1; then
        DEV="$(findmnt -no SOURCE --target "$LFS" 2>/dev/null | sed 's/\[.*\]//' | tr -d '[:space:]')"
        VOLUME="$(findmnt -no OPTIONS --target "$LFS" 2>/dev/null | sed -n 's/.*subvol=\([^,]*\).*/\1/p' || true)"
    fi
    if [[ -z "$DEV" ]] || [[ ! -b "$DEV" ]]; then
        DEV="$(df -P "$LFS" | awk 'NR==2{print $1}' | sed 's/\[.*\]//')"
    fi
    if [[ ! -b "$DEV" ]]; then
        echo "Error: No se pudo detectar dispositivo válido para $LFS" >&2
        exit 1
    fi
    echo "Dispositivo detectado: $DEV"
    if command -v blkid >/dev/null 2>&1; then
        UUID="${UUID_OVERRIDE:-$(blkid -o value -s UUID "$DEV" 2>/dev/null)}"
        FSTYPE="${FSTYPE_OVERRIDE:-$(blkid -o value -s TYPE "$DEV" 2>/dev/null)}"
        # Fallback a sed parsing si -o value no es soportado (busybox antiguo)
        if [[ -z "$UUID" ]]; then
            local BLKID_OUT
            BLKID_OUT="$(blkid "$DEV" 2>/dev/null || true)"
            UUID="${UUID_OVERRIDE:-$(echo "$BLKID_OUT" | sed -n 's/.*UUID="\([^"]*\)".*/\1/p')}"
            FSTYPE="${FSTYPE_OVERRIDE:-$(echo "$BLKID_OUT" | sed -n 's/.*TYPE="\([^"]*\)".*/\1/p')}"
        fi
    fi
    if [[ -z "$UUID" ]]; then
        echo "Error: No se pudo obtener UUID de $DEV" >&2
        exit 1
    fi
    echo "UUID: $UUID | Tipo: $FSTYPE"
    if [[ "$FSTYPE" == "btrfs" ]]; then
        MOUNT_OPTS="compress=zstd:3,noatime,subvol=$VOLUME"
        FS_PASS="0 0"
    else
        MOUNT_OPTS="defaults"
        FS_PASS="0 1"
    fi
    # Detectar particiones swap en la misma unidad
    SWAP_ENTRIES=""
    detect_base_disk || true
    if [[ -n "$BASE_DISK" && -b "$BASE_DISK" ]] && command -v lsblk >/dev/null 2>&1; then
        while IFS= read -r PART; do
            [[ -z "$PART" || "$PART" == "$(basename "$DEV")" ]] && continue
            PART_DEV="/dev/$PART"
            SWAP_UUID=$(blkid -o value -s UUID "$PART_DEV" 2>/dev/null || true)
            SWAP_TYPE=$(blkid -o value -s TYPE "$PART_DEV" 2>/dev/null || true)
            if [[ "$SWAP_TYPE" == "swap" && -n "$SWAP_UUID" ]]; then
                SWAP_ENTRIES="${SWAP_ENTRIES}UUID=${SWAP_UUID}  none  swap  sw  0  0"$'\n'
                echo "    [INFO] swap detectado: $PART_DEV ($SWAP_UUID)"
            fi
        done < <(lsblk -ln -o NAME,TYPE "$BASE_DISK" 2>/dev/null | awk '$2=="part"{print $1}')
    fi

    # Detectar partición EFI y obtener UUID
    EFI_ENTRY=""
    detect_efi || true
    if [[ -n "$EFI_PART" ]] && command -v blkid >/dev/null 2>&1; then
        local EFI_UUID
        EFI_UUID=$(blkid -o value -s UUID "$EFI_PART" 2>/dev/null || true)
        if [[ -n "$EFI_UUID" ]]; then
            EFI_ENTRY="UUID=$EFI_UUID  $EFI_DIR  vfat  defaults  0  2"$'\n'
            echo "    [INFO] entrada EFI agregada al fstab: $EFI_PART → $EFI_DIR"
        fi
    fi

    cat > "${LFS}/etc/fstab" <<EOF
# Generated by neonatox-bootstrap

${EFI_ENTRY}
UUID=$UUID  /  $FSTYPE  $MOUNT_OPTS  $FS_PASS
${SWAP_ENTRIES}
EOF
    echo "    [INFO] fstab generado"

    # hosts / hostname — usa DMI + random
    if [[ -z "${NHOSTNAME:-}" ]]; then
        vendor=$(cat /sys/devices/virtual/dmi/id/board_vendor 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/^-\+//;s/-\+$//' | cut -c1-6)
        model=$(cat /sys/devices/virtual/dmi/id/board_name 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/^-\+//;s/-\+$//' | cut -c1-6)
        ramdomnum=$(head /dev/urandom | tr -dc 'a-f0-9' | head -c 4)
        NHOSTNAME="${vendor}-${model}-${ramdomnum}"
    fi
    cat > "${LFS}/etc/hosts" <<EOF
127.0.0.1  localhost ${NHOSTNAME}
::1        localhost

EOF
	echo "    [INFO] hosts generado"

    cat > "${LFS}/etc/hostname" <<EOF
# Begin /etc/hostname
${NHOSTNAME}

# End /etc/hostname
EOF

	echo "    [INFO] hostname generado"

    # timezone
    if [[ -z "${TZONE:-}" ]] && command -v readlink >/dev/null 2>&1; then
        TZONE="$(readlink /etc/localtime 2>/dev/null | sed -n 's|.*/zoneinfo/||p')"
    fi
    TZONE="${TZONE:-America/Caracas}"
    ln -sf "/usr/share/zoneinfo/${TZONE}" "${LFS}/etc/localtime"
    echo "${TZONE}" > "${LFS}/etc/timezone"
    
    echo "    [INFO] timezone generado"

    # machine-id
    if command -v openssl >/dev/null 2>&1; then
        openssl rand -hex 16 > "${LFS}/etc/machine-id"
    elif [[ -r /proc/sys/kernel/random/boot_id ]]; then
        tr -d '-' < /proc/sys/kernel/random/boot_id > "${LFS}/etc/machine-id"
    elif [[ -r /proc/sys/kernel/random/uuid ]]; then
        tr -d '-' < /proc/sys/kernel/random/uuid > "${LFS}/etc/machine-id"
    else
        echo "deadbeefdeadbeefdeadbeefdeadbeef" > "${LFS}/etc/machine-id"
    fi
    
    echo "    [INFO] machine-id generado"
    
    echo "=== [core] Poblando BD de paquetes e instalando core ==="
    nhopkg_prepare
    # /bin/sh -> bash para que los hooks corran con bash (libnhopkg es bash-only)
    ln -sf bash "${LFS}/usr/bin/sh" > /dev/null 2>&1

    nhopkg --root "$LFS" -U
    nhopkg --root "$LFS" -RS $(awk 'NF && !/^#/' "$PACKS_DIR/base") $(awk 'NF && !/^#/' "$PACKS_DIR/base-extra")
    # En modo host no hay árbol DESTDIR: el nhopkg final del sistema va como
    # paquete (solo si un run anterior no dejó ya un binario en $LFS).
    if [[ "$HOST_NHOPKG" == "1" && ! -x "$LFS/usr/bin/nhopkg" ]]; then
        nhopkg --root "$LFS" -RS nhopkg --no-check-deps
    fi
    # More common linux firmware files
    # nhopkg --root "$LFS" -RS $(awk 'NF && !/^#/' "$PACKS_DIR/linux-firmware")
    nhopkg --root "$LFS" -RS grub --no-check-deps
    
    # awk de GNU, si el paquete lo dejó disponible
    [ -e "${LFS}/usr/bin/gawk" ] && ln -sf gawk "${LFS}/usr/bin/awk" > /dev/null 2>&1
	    
    touch "$CORE_SENTINEL"
    echo "=== [core] Ready ==="
}

##################################################
#  Desktop-common setup (shared by all DEs)
##################################################
install_desktop_common() {
	section="Desktop Common"
    # Verificar si esta instalada la seccion
    de_common_instalado && return 0
    
    nhopkg_prepare
    
    #Instalar paquetes de la seccion
    nhopkg --root "$LFS" -RS $(awk 'NF && !/^#/' "$PACKS_DIR/desktop-common")
    
    # el servicio de lightdm no se activa a si mismo, asi que para cumplir
    # con el proposito de desktop-common lo activamos desde aqui
    chroot_prepare
    chroot_run "systemctl enable lightdm"
    chroot_cleanup
    
    touch "$DE_SENTINEL"
}

##################################################
#  Desktop post-install cleanup
##################################################
cleanup() {
    if [[ -z "${SKIP_CLEANUP:-}" ]]; then
        chroot_run "rm -rf /var/run/lock/nhopkg /usr/src/* /var/nhopkg/cache/* /tmp/* /tmp/.* 2>/dev/null; exit 0"
    fi
}

##################################################
#  KDE
##################################################
install_kde() {
    # Asegurar dependencias (core + desktop-common se saltan si ya instalados)
    core_instalado || install_core
    install_desktop_common
    nhopkg_prepare
    
    section="KDE"
    
    #Instalar paquetes de la seccion
    nhopkg --root "$LFS" -RS $(awk 'NF && !/^#/' "$PACKS_DIR/kde") $(awk 'NF && !/^#/' "$PACKS_DIR/kde-extra")
}

